# Copy to .env and fill in. Never commit .env.
# In AWS, read these from Secrets Manager / SSM Parameter Store at task start
# rather than baking them into an image or a task definition.

ENV=development
PORT=8000

# PostgreSQL. On RDS, use the writer endpoint and require TLS.
DATABASE_URL=postgres://crm:crm@localhost:5432/crm
PGSSL=disable
# set PGSSL=require for RDS
PG_POOL_MIN=2
PG_POOL_MAX=10

# Number of proxy hops in front of the app (ALB = 1, CloudFront + ALB = 2).
# Getting this wrong makes rate limiting trust a spoofed X-Forwarded-For.
TRUST_PROXY_HOPS=1

# Origins allowed to POST to the public form intake endpoint.
# Comma-separated, exact scheme + host. "*" is dev-only.
PUBLIC_FORM_ORIGINS=http://localhost:5173,https://www.example.com

# Cloudflare Turnstile. Leave blank locally; set in staging and production
# or the only thing standing between your pipeline and bots is the honeypot.
TURNSTILE_SECRET=

# Self-service sign-up at /register (creates a new workspace + owner).
# There is no email verification yet — set 0 on invite-only installs.
ALLOW_SIGNUPS=1

# Set to 0 on extra replicas so only one process polls the webhook queue.
RUN_WORKERS=1
WEBHOOK_POLL_SECONDS=15

# Outbound email (lead notifications, password reset).
# 'log' prints messages to the app log — dev default, nothing is sent.
# 'smtp' relays through any SMTP provider; in production use Amazon SES
# SMTP credentials (Brevo/SendGrid/Mailgun work the same way).
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="CRM Admin <no-reply@example.com>"
EMAIL_POLL_SECONDS=10
# Absolute origin used in email links (password reset). Leave blank to use
# the request host; set explicitly behind CloudFront or multiple domains.
APP_BASE_URL=

# Seed script only
SEED_TENANT_SLUG=demo
SEED_TENANT_NAME="Demo Client"
OWNER_EMAIL=admin@example.com
OWNER_PASSWORD=ChangeMe!2026

# =====================================================================
# Platform settings (content, media, publishing, analytics, backups)
# =====================================================================

# Hosts whose <iframe> embeds survive rich-text sanitization. Anything
# not listed is stripped from content bodies. Comma-separated; leave
# blank for the built-in list (YouTube, Vimeo, Spotify, Maps, Calendly).
EMBED_ALLOWED_HOSTS=

# ------------------------------------------------------------- media
# 'local' writes under MEDIA_ROOT — fine for one box, but a container
# filesystem is ephemeral, so this is a development default.
# 's3' is the production path.
MEDIA_STORAGE=local
MEDIA_ROOT=var/media
MEDIA_S3_BUCKET=
MEDIA_S3_PREFIX=media
# CloudFront (or any CDN) domain in front of the bucket. Set this and
# the bucket can stay private — media URLs point at the distribution.
MEDIA_PUBLIC_BASE_URL=
AWS_REGION=

# ------------------------------------------------------- publishing
# Public origin of the *website* (not this admin). Used for absolute
# URLs in sitemaps and canonical tags when a tenant has not set its own
# site URL in Settings → Site identity.
SITE_BASE_URL=
# CloudFront distribution to invalidate after a publish. Blank leaves
# invalidations queued-but-skipped, which is right for a pull CDN that
# honours cache-control.
CLOUDFRONT_DISTRIBUTION_ID=

# ------------------------------------------------------- analytics
# Salt for the rotating daily visitor hash used by the first-party
# beacon. Set it to a long random string; rotating it severs any link
# between old and new visitor counts. Leave blank and the beacon still
# works, but the hash is unsalted.
ANALYTICS_SALT=

# --------------------------------------------------------- backups
# Off-server destination for pg_dump output. Without it, dumps stay on
# this server's disk — which is not a backup. Scheduled backups only
# run when this is set.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups
# pg_dump must be on PATH (or give an absolute path) for database backups.
PG_DUMP_PATH=pg_dump

# ---------------------------------------------------------- workers
# Poll intervals for the platform workers. All of them run in the ONE
# process with RUN_WORKERS=1; set RUN_WORKERS=0 on every other replica.
CONTENT_POLL_SECONDS=30
BUILD_POLL_SECONDS=15
HEALTH_POLL_SECONDS=60
CAMPAIGN_BATCH_SIZE=50
# Hours between retention sweeps. 0 disables retention enforcement.
RETENTION_HOUR_INTERVAL=6

# =====================================================================
# Multi-site isolation
# =====================================================================

# Declare the tenant on each scoped connection so the row-level-security
# policies in db/tenancy.sql apply. Costs one extra round trip per
# query. TenantDB's bound-$1 scoping is unconditional either way.
PG_RLS=1

# IMPORTANT: RLS only bites when the app connects as a role that is
# neither a superuser nor BYPASSRLS. db/tenancy.sql creates `crm_app`
# for exactly this; give it a password from your secret store and point
# DATABASE_URL at it. /healthz reports whether it is actually in force.
#
#   psql "$DATABASE_URL" -c "ALTER ROLE crm_app PASSWORD '<secret>'"
#   DATABASE_URL=postgres://crm_app:<secret>@host:5432/crm

# Origins allowed on the public API *in addition* to each site's own
# verified domains. Per-site domains are the real allow-list now — this
# is a development escape hatch and a stopgap for a frontend whose
# domain is not registered yet. "*" is dev-only.
# (PUBLIC_FORM_ORIGINS above still applies.)

# =====================================================================
# Integrations (connectors)
# =====================================================================

# Fernet key encrypting connector credentials at rest — OAuth refresh
# tokens and provider API keys. Generate one with:
#   python -c "from app.crypto import generate_key; print(generate_key())"
#
# Without it, any integration that stores a secret refuses to save
# rather than keeping it in the clear. Comma-separate for rotation:
# the first key encrypts, all of them decrypt. After adding a new key,
# re-encrypt with app.crypto.rotate_all() before dropping the old one.
CREDENTIALS_KEY=

# Absolute origin OAuth providers redirect back to. Must match the
# callback URL registered with Zoho/Salesforce exactly — a trailing
# slash is enough to fail the exchange. Defaults to APP_BASE_URL.
#   <origin>/api/integrations/oauth/{provider}/callback
OAUTH_REDIRECT_BASE=

# How often the connector queue is drained.
CONNECTOR_POLL_SECONDS=10

# =====================================================================
# Scale
# =====================================================================

# Which background workers this process runs. Blank or "all" runs every
# one, which is right for a single install. A comma-separated subset is
# how heavy jobs move to their own service:
#
#   web tier      RUN_WORKERS=0
#   general       WORKERS=publish,campaigns,builds,health,retention,backups,usage
#   image tier    WORKERS=media          (the only CPU-bound worker)
#   delivery tier WORKERS=connectors
#
# Names: publish campaigns builds health retention backups usage
#        connectors media
# /healthz lists which run here and — more usefully — which do not.
WORKERS=

# Image derivative generation. Polls faster while a backlog exists, so
# this is only the idle interval.
MEDIA_POLL_SECONDS=5

# Rate limiting. 'memory' counts per process, so with several uvicorn
# workers or Fargate tasks the effective limit is multiplied by the
# process count — correct only for single-process development.
# 'postgres' shares the counters with no new infrastructure; 'redis'
# once the write volume outgrows that.
RATE_LIMIT_BACKEND=memory
REDIS_URL=

# Read replicas, comma separated. Reads that opt in (portfolio, API
# version usage) go here; everything else stays on the writer, because
# replication lag breaks read-after-write. Empty is correct until read
# volume justifies it.
DATABASE_REPLICA_URLS=

# Cross-process cache invalidation over LISTEN/NOTIFY. With it off, a
# permission change or a site suspension takes up to the cache TTL
# (~30s) to reach every replica instead of milliseconds.
CACHE_NOTIFY=1
