# Copy to .env and fill in. Never commit .env.
# In AWS, read these from Secrets Manager / SSM Parameter Store at task start
# rather than baking them into an image or a task definition.

ENV=development
PORT=8000

# PostgreSQL. On RDS, use the writer endpoint and require TLS.
DATABASE_URL=postgres://crm:crm@localhost:5432/crm
PGSSL=disable
# set PGSSL=require for RDS
PG_POOL_MIN=2
PG_POOL_MAX=10

# Number of proxy hops in front of the app (ALB = 1, CloudFront + ALB = 2).
# Getting this wrong makes rate limiting trust a spoofed X-Forwarded-For.
TRUST_PROXY_HOPS=1

# Origins allowed to POST to the public form intake endpoint.
# Comma-separated, exact scheme + host. "*" is dev-only.
PUBLIC_FORM_ORIGINS=http://localhost:5173,https://www.example.com

# Cloudflare Turnstile. Leave blank locally; set in staging and production
# or the only thing standing between your pipeline and bots is the honeypot.
TURNSTILE_SECRET=

# Self-service sign-up at /register (creates a new workspace + owner).
# There is no email verification yet — set 0 on invite-only installs.
ALLOW_SIGNUPS=1

# Set to 0 on extra replicas so only one process polls the webhook queue.
RUN_WORKERS=1
WEBHOOK_POLL_SECONDS=15

# Seed script only
SEED_TENANT_SLUG=demo
SEED_TENANT_NAME="Demo Client"
OWNER_EMAIL=admin@example.com
OWNER_PASSWORD=ChangeMe!2026
